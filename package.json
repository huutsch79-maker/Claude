{
  "name": "jarvis-v2",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS v2 - domain-isolated personal AI assistant orchestrator (work / personal)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/orchestrator/index.js",
    "dev": "tsx src/orchestrator/index.ts",
    "seed": "tsx scripts/seed-registry.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
