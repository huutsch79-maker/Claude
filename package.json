{
  "name": "jarvis-v2",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS v2 - unified personal AI assistant orchestrator",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/orchestrator/index.js",
