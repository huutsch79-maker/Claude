# JARVIS v2 environment — copy to .env and fill in.
#
# Credential separation is enforced by prefix: everything under
# JARVIS_WORK_* is only ever readable by the work DomainInstance, and
# everything under JARVIS_PERSONAL_* only by the personal one (see
# src/domain/credentialStore.ts). Never put a work secret under a
# JARVIS_PERSONAL_ key or vice versa.

# --- Postgres (shared server, strictly separated schemas + roles) ---
JARVIS_DB_HOST=localhost
JARVIS_DB_PORT=5432
JARVIS_DB_NAME=jarvis
JARVIS_DB_SUPERUSER_PASSWORD=change_me_superuser

JARVIS_WORK_DB_USER=jarvis_work
JARVIS_WORK_DB_PASSWORD=change_me_work
JARVIS_PERSONAL_DB_USER=jarvis_personal
JARVIS_PERSONAL_DB_PASSWORD=change_me_personal

# --- Work domain (NZB) credentials ---
JARVIS_WORK_NZB_M365_OAUTH=
JARVIS_WORK_NZB_M365_OAUTH_EXPIRES_AT=
JARVIS_WORK_DYNAMICS_BASE_URL=https://api.businesscentral.dynamics.com/v2.0
JARVIS_WORK_PUSHOVER_TOKEN=
JARVIS_WORK_PUSHOVER_USER=

# --- Work domain Azure Cost Management (ARM client-credentials app
#     registration). All four required, or the dashboard's Azure cost
#     panel reports "not_configured" — read directly, not via
#     CredentialStore (see src/modules/work/nzb-connector/azureCost.ts). ---
JARVIS_WORK_AZURE_TENANT_ID=
JARVIS_WORK_AZURE_CLIENT_ID=
JARVIS_WORK_AZURE_CLIENT_SECRET=
JARVIS_WORK_AZURE_SUBSCRIPTION_ID=

# --- Personal domain credentials ---
JARVIS_PERSONAL_HOTMAIL_OAUTH=
JARVIS_PERSONAL_HOTMAIL_OAUTH_EXPIRES_AT=
JARVIS_PERSONAL_PUSHOVER_TOKEN=
JARVIS_PERSONAL_PUSHOVER_USER=

# --- Orchestrator ---
JARVIS_REVIEWER_INTERVAL_MS=1800000
JARVIS_HEALTH_INTERVAL_MS=300000
JARVIS_CONTENT_INTERVAL_MS=900000

# --- Dashboard (in-process monitoring + chat UI — see docs/architecture.md) ---
JARVIS_DASHBOARD_ENABLED=true
JARVIS_DASHBOARD_HOST=127.0.0.1
JARVIS_DASHBOARD_PORT=7317

# --- Model routing (default reasoning layer; per-capability overrides live
#     in each capability's registry row, not here) ---
ANTHROPIC_API_KEY=
JARVIS_EMBEDDING_PROVIDER=
