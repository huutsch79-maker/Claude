# JARVIS v2 environment — copy to .env and fill in.
#
# Memory and chat are unified — one assistant, one conversation, full
# context across everything. What still stays genuinely separate is
# credentials: each capability points at its own JARVIS_CRED_* value (see
# src/domain/credentialStore.ts), because e.g. NZB's M365 tenant and a
# personal Hotmail account are different real-world accounts regardless
# of how the data layer is organized.

# --- Postgres ---
JARVIS_DB_HOST=localhost
JARVIS_DB_PORT=5432
JARVIS_DB_NAME=jarvis
JARVIS_DB_SUPERUSER_PASSWORD=change_me_superuser

JARVIS_APP_DB_USER=jarvis_app
JARVIS_APP_DB_PASSWORD=change_me_app

# --- Capability credentials (one JARVIS_CRED_<REF> per capability's credential_ref) ---
JARVIS_CRED_NZB_M365_OAUTH=
JARVIS_CRED_NZB_M365_OAUTH_EXPIRES_AT=
JARVIS_NZB_DYNAMICS_BASE_URL=https://api.businesscentral.dynamics.com/v2.0

JARVIS_CRED_HOTMAIL_OAUTH=
JARVIS_CRED_HOTMAIL_OAUTH_EXPIRES_AT=

# --- Approval notifications ---
JARVIS_PUSHOVER_TOKEN=
JARVIS_PUSHOVER_USER=

# --- Orchestrator ---
JARVIS_REVIEWER_INTERVAL_MS=1800000
JARVIS_HEALTH_INTERVAL_MS=300000

# --- Ops dashboard (src/orchestrator/dashboard.ts) ---
# Set this before relying on the dashboard beyond a trusted home network —
# without it the API runs unauthenticated (fine for local dev, logs a
# warning on startup either way). Any long random string works.
JARVIS_DASHBOARD_TOKEN=
JARVIS_DASHBOARD_PORT=4570

# --- Model routing (default reasoning layer; per-capability overrides live
#     in each capability's registry row, not here) ---
ANTHROPIC_API_KEY=
JARVIS_EMBEDDING_PROVIDER=

# Optional chat model override — defaults to claude-opus-5 if unset.
JARVIS_CHAT_MODEL=
