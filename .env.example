# JARVIS v2 environment — copy to .env and fill in.
#
# Memory and chat are unified — one assistant, one conversation, full
# context across everything. What still stays genuinely separate is
# credentials: each capability points at its own JARVIS_CRED_* value (see
# src/domain/credentialStore.ts), because e.g. NZB's M365 tenant and a
# personal Hotmail account are different real-world accounts regardless
# of how the data layer is organized.

# --- Postgres ---
JARVIS_DB_HOST=localhost
JARVIS_DB_PORT=5432
JARVIS_DB_NAME=jarvis
JARVIS_DB_SUPERUSER_PASSWORD=change_me_superuser

JARVIS_APP_DB_USER=jarvis_app
JARVIS_APP_DB_PASSWORD=change_me_app

# --- Capability credentials (one JARVIS_CRED_<REF> per capability's credential_ref) ---
JARVIS_CRED_NZB_M365_OAUTH=
JARVIS_CRED_NZB_M365_OAUTH_EXPIRES_AT=
JARVIS_NZB_DYNAMICS_BASE_URL=https://api.businesscentral.dynamics.com/v2.0

JARVIS_CRED_HOTMAIL_OAUTH=
JARVIS_CRED_HOTMAIL_OAUTH_EXPIRES_AT=

# --- Delegated OAuth apps (real interactive Microsoft consent) ---
# hotmail-outlook and nzb-m365-connector need actual delegated access to a
# real mailbox — a static token can't do that; a human has to click through
# Microsoft's consent screen. Set one JARVIS_OAUTH_APP_<CREDENTIAL_REF> per
# capability (JSON, single-quoted) and a "Connect" button appears next to
# that capability in the dashboard. Completing the flow stores a real,
# self-refreshing access+refresh token pair in jarvis.oauth_credentials —
# no redeploy needed afterward. See docs/architecture.md "Delegated OAuth".
# The redirect URI Microsoft sends the browser back to is built from
# JARVIS_DASHBOARD_PUBLIC_URL, so that must be set and must exactly match
# a Redirect URI registered on the app (https://<host>/api/oauth/callback).
#   JARVIS_OAUTH_APP_HOTMAIL_OAUTH='{"tenantId":"<guid>","clientId":"<guid>","clientSecret":"<value>","scopes":["Mail.Read","Mail.Send"]}'
JARVIS_DASHBOARD_PUBLIC_URL=
JARVIS_OAUTH_APP_HOTMAIL_OAUTH=
JARVIS_OAUTH_APP_NZB_M365_OAUTH=

# Read-only tenant insight capabilities — deliberately narrow-scoped
# credentials (see docs/architecture.md "Tenant insights"): standing app
# permissions/RBAC roles are NOT gated by PIM the way a human admin's role
# activation is, so these must only ever be granted read-only access
# (Graph Reports.Read.All; Azure Reader + Cost Management Reader RBAC —
# never Contributor or any admin role).
#
# Unlike the other JARVIS_CRED_* values above, these two are app-only
# (client-credentials) OAuth apps, not a raw token — the value is a JSON
# object, single-quoted so dotenv keeps it as one string. The _EXPIRES_AT
# companion is the CLIENT SECRET's own expiry (whatever you picked when
# creating it in Azure — e.g. 6/12/24 months out), not an access token's;
# SecurityAccess uses it to warn before the secret itself needs rotating.
#   JARVIS_CRED_NZB_USAGE_REPORT_OAUTH='{"tenantId":"<guid>","clientId":"<guid>","clientSecret":"<value>"}'
JARVIS_CRED_NZB_USAGE_REPORT_OAUTH=
JARVIS_CRED_NZB_USAGE_REPORT_OAUTH_EXPIRES_AT=

JARVIS_CRED_NZB_AZURE_INSIGHTS_OAUTH=
JARVIS_CRED_NZB_AZURE_INSIGHTS_OAUTH_EXPIRES_AT=
JARVIS_NZB_AZURE_SUBSCRIPTION_ID=

# --- Approval notifications ---
JARVIS_PUSHOVER_TOKEN=
JARVIS_PUSHOVER_USER=

# --- Autonomous fix-loop bridge (see docs/architecture.md "Autonomous fix
# loop") — optional. When set, the Reviewer files a GitHub issue if a
# capability fails 3+ times in 24h, so a scheduled Claude Code session can
# diagnose and fix it. JARVIS only ever reports; it never writes code or
# deploys anything itself. A fine-grained PAT scoped to Issues:write on
# this one repo only — leave unset to disable the integration entirely.
JARVIS_CRED_GITHUB_ISSUES=
JARVIS_GITHUB_REPO=

# --- Orchestrator ---
JARVIS_REVIEWER_INTERVAL_MS=1800000
JARVIS_HEALTH_INTERVAL_MS=300000

# --- Ops dashboard (src/orchestrator/dashboard.ts) ---
# Set this before relying on the dashboard beyond a trusted home network —
# without it the API runs unauthenticated (fine for local dev, logs a
# warning on startup either way). Any long random string works.
JARVIS_DASHBOARD_TOKEN=
JARVIS_DASHBOARD_PORT=4570

# --- Model routing (default reasoning layer; per-capability overrides live
#     in each capability's registry row, not here) ---
ANTHROPIC_API_KEY=
JARVIS_EMBEDDING_PROVIDER=

# Optional chat model override — defaults to claude-opus-5 if unset.
JARVIS_CHAT_MODEL=
